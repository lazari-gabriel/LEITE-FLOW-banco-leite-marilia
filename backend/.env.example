# ==============================================================================
# LEITE FLOW BACKEND — Variáveis de Ambiente (.env.example)
# ==============================================================================
NODE_ENV="development"
PORT=3333
HOST="0.0.0.0"

# Banco de Dados:
# - Desenvolvimento local (SQLite): file:./dev.db
# - Produção online (PostgreSQL — Neon, Supabase, Railway, Render):
#   postgresql://USER:PASSWORD@HOST:5432/leiteflow?sslmode=require
DATABASE_URL="file:./dev.db"

# Segredos JWT (GERE CHAVES FORTES DE 64+ CARACTERES EM PRODUÇÃO!)
JWT_ACCESS_SECRET="troque-esta-chave-access-em-producao-minimo-32-caracteres"
JWT_REFRESH_SECRET="troque-esta-chave-refresh-em-producao-minimo-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Origens permitidas no CORS (separadas por vírgula — adicione sua URL da Vercel em produção)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Cookie seguro (true em produção HTTPS)
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
