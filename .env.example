# ==============================================================================
# BANCO DE LEITE HUMANO DE MARÍLIA - SISTEMA DE GESTÃO & LOGÍSTICA DE COLETA
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================

# Configurações do Aplicativo Frontend
VITE_APP_TITLE="Banco de Leite Humano de Marília"
VITE_APP_ENV="development"
VITE_APP_PORT=3000

# Hospital Sede BLH Marília
VITE_BLH_NAME="Hospital Materno Infantil de Marília"
VITE_BLH_LAT="-22.21735"
VITE_BLH_LNG="-49.94692"

# Camada de Mapas (Opcional caso utilize provedor com Token, ex: Mapbox / Stadia)
VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"

# API Backend (Para migração futura de Mock para API REST/GraphQL)
VITE_API_BASE_URL="http://localhost:3333/api"
